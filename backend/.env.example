# 复制本文件为 .env 后填写（.env 不会被 git 跟踪）

# ===== 安全密钥 =====
# 必须显式设置成一段高强度随机字符串（可用 python -c "import secrets;print(secrets.token_urlsafe(32))" 生成）。
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===== AI 大模型（OpenAI 兼容协议，任选一家）=====
# 详细接入步骤见网页右上角「接入教程」按钮。
#
# 【DeepSeek（推荐）】
#LLM_BASE_URL=https://api.deepseek.com/v1
#LLM_MODEL=deepseek-chat
#LLM_API_KEY=sk-your-api-key
#
# 【阿里云百炼 / 通义】
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# LLM_API_KEY=sk-your-api-key
#
# 【本地 Ollama（免费）】
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5
# LLM_API_KEY=ollama

# ===== 向量模型（Embedding，主对话历史语义检索用）=====
# 默认走本地 Ollama 的 bge-m3（免费、中文友好、隐私不外发）。
# 换模型后请删除旧向量库（ops/data/vector_db），否则维度不一致会检索失败。
#
# 【本地 Ollama（默认，免费）】
# EMBEDDING_BASE_URL=http://localhost:11434
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_API_KEY=
# EMBEDDING_DIM=1024
#
# 【OpenAI 兼容（云端，如硅基流动/百炼等）】
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_API_KEY=sk-your-api-key
# EMBEDDING_DIM=1024

# ===== 图片解析（多模态视觉）=====
# 图片内容识别通道，按优先级自动选择：
#   1. 阿里云百炼 / 通义千问 VL（DASHSCOPE_API_KEY 非空时优先）
#   2. 本地 Ollama 视觉模型（IMAGE_VL_MODEL 非空且 Ollama 在运行时）
#   3. 都不可用 → 降级为仅 PIL 基础信息（不报错，不打断 Agent）
# 二选一填一个即可：
# 【方案 A：云端通义千问 VL】
# DASHSCOPE_API_KEY=sk-your-dashscope-key
# IMAGE_VL_MODEL=qwen-vl-plus
# 【方案 B：本地 Ollama 视觉（免费离线，推荐，先 ollama pull qwen2.5vl:7b）】
# DASHSCOPE_API_KEY=
# IMAGE_VL_MODEL=qwen2.5vl:7b

# ===== 数据库 =====
# 留空/不设置 = 数据落在默认数据目录（Windows 桌面环境为 %APPDATA%/Jingent/app.db）。
#
# 服务端部署时按需显式指定：
# SQLALCHEMY_DATABASE_URL=sqlite:////var/lib/jingent/app.db
# 如需 MySQL（并安装 pymysql）：
# SQLALCHEMY_DATABASE_URL=mysql+pymysql://root:password@localhost:3306/ai_rove

# ===== 未登录用户聊天限流：每个 IP 每天最多免费体验多少次（跨自然日自动重置）=====
ANONYMOUS_RATE_LIMIT_MAX=10

# ===== 后台管理员（访问 /admin 登录用）=====
# 密码务必改成强密码；留空则后台登录一律被拒绝。建议给 /admin 配 HTTPS。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
