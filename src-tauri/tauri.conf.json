{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jingent AI",
  "identifier": "com.jingent.ai",
  "build": {
    "beforeDevCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File \"../start_backend.ps1\"",
    "beforeBuildCommand": "",
    "devUrl": "http://127.0.0.1:8000/jinclaw?is_desktop=1",
    "frontendDist": "../static"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Jingent AI — Jinclaw Coding Agent",
        "width": 1600,
        "height": 960,
        "minWidth": 1200,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "externalBin": ["binaries/backend"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/johnjincaaaa/AI_Agent_joooo/releases/latest/download/latest.json"
      ],
